// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  name           String?
  credits        Int             @default(10)
  role           String          @default("user")
  status         String          @default("active")
  plan           String          @default("free")
  planExpiresAt  DateTime?
  createdAt      DateTime        @default(now())
  lastActiveAt   DateTime?
  smtpAccounts   SmtpAccount[]
  leads          Lead[]
  campaigns      Campaign[]
  templates      Template[]
  creditHistory  CreditHistory[]
  payments       Payment[]
}

model SmtpAccount {
  id        String   @id @default(cuid())
  userId    String
  email     String
  password  String
  provider  String   // "gmail" | "outlook"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String   @id @default(cuid())
  userId       String
  name         String
  email        String
  businessName String?
  niche        String?
  previewUrl   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id        String   @id @default(cuid())
  userId    String
  name      String
  status    String   @default("draft") // "draft" | "running" | "complete" | "failed"
  total     Int      @default(0)
  sent      Int      @default(0)
  failed    Int      @default(0)
  subject   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditHistory {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "add" | "deduct" | "reset" | "purchase"
  amount    Int
  reason    String?
  adminId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int      // in paise (₹1 = 100)
  currency          String   @default("INR")
  status            String   @default("created") // "created" | "paid" | "failed"
  plan              String   @default("pro_monthly")
  creditsAwarded    Int      @default(0)
  createdAt         DateTime @default(now())
  paidAt            DateTime?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  coverImage      String?
  category        String   @default("Client Acquisition")
  readingTime     String   @default("5 min read")
  tags            String[] @default([])
  featured        Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])
  authorName      String   @default("Rohit Sharma")
  authorRole      String   @default("Founder & CEO, WebKarigar")
  authorAvatar    String?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RawAd {
  id                 String    @id @default(cuid())
  niche              String
  keyword            String
  country            String    @default("IN")
  hash               String    @unique
  pageId             String?
  pageName           String?
  adText             String?
  ctaLink            String?
  publisherPlatforms String[]  @default([])
  adCreationTime     DateTime?
  rawJson            Json?
  createdAt          DateTime  @default(now())
  aiLeads            AILead[]
}

model AILead {
  id              String   @id @default(cuid())
  rawAdId         String?
  rawAd           RawAd?   @relation(fields: [rawAdId], references: [id], onDelete: SetNull)
  niche           String
  businessName    String
  phone           String?
  email           String?
  emails          String[] @default([])
  city            String?
  hasWebsite      Boolean  @default(false)
  ctaLink         String?
  adText          String?
  isLead          Boolean  @default(true)
  confidence      String   @default("medium")
  rejectionReason String?
  slug            String?
  demoLinks       String[] @default([])
  messageDraft    String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
